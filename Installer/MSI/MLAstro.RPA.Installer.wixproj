<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Suppress ICE64 and ICE91 warnings for perUser installation.
         ICE61 is also suppressed: Package.wxs intentionally uses AllowSameVersionUpgrades="yes",
         so WiX includes the current version in the upgrade range and ICE61 (WIX1076) reports the
         benign "Maximum version is not less than the current product" false positive on every build. -->
    <SuppressIces>ICE64;ICE91;ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MLAstro_Robotic_Polar_Alignment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
