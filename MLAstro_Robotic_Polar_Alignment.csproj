<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net8.0-windows</TargetFramework>
	  <UseWPF>true</UseWPF>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<RunPostBuildEvent>OnOutputUpdated</RunPostBuildEvent>

	<!-- Always run the post-build targets (copy DLL to NINA plugin folder + MSI staging).
	     The .NET SDK's FastUpToDateCheck skips the whole Build target (including PostBuild)
	     on unchanged incremental builds, so the copy-confirmation messages never appear. -->
	<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>

	<!-- MSB3277: System.Text.Json 8.0 vs 9.0 conflict comes from the third-party NINA.PlateSolving.dll
	     (it references System.Text.Json 9.0; net8.0 provides 8.0). Benign at runtime - unified to 8.0. -->
	<!-- NU1701: ToastNotifications / VVVV.FreeImage chỉ có bản .NET Framework cũ (benign, qua NINA deps) -->
	<NoWarn>$(NoWarn);MSB3277;NU1701</NoWarn>

	<!-- Single-DLL output: skip .pdb debug symbols and .deps.json dependency manifest -->
	<DebugType>none</DebugType>
	<DebugSymbols>false</DebugSymbols>
	<GenerateDependencyFile>false</GenerateDependencyFile>

	<!-- Assembly Info for PluginBase -->
	<AssemblyTitle>MLAstro Robotic Polar Alignment</AssemblyTitle>
  <AssemblyVersion>2.0.0.1</AssemblyVersion>
  <FileVersion>2.0.0.1</FileVersion>
	<Company>MLAstro</Company>

	<!-- Generate COM GUID for assembly - required by PluginBase for Identifier -->
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Plugin Metadata for PluginBase -->
  <ItemGroup>
	<AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
	  <_Parameter1>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</_Parameter1>
	</AssemblyAttribute>
	<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	  <_Parameter1>MinimumApplicationVersion</_Parameter1>
	  <!-- The plugin is compiled against NINA 3.0.0.9001 (the oldest supported 3.x) so it runs on NINA 3.0 and later.
	       Keep this in sync with the NINA.Plugin PackageReference version below. -->
	  <_Parameter2>3.0.0.0</_Parameter2>
	</AssemblyAttribute>
	<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	  <_Parameter1>License</_Parameter1>
	  <_Parameter2>MPL-2.0</_Parameter2>
	</AssemblyAttribute>
	<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	  <_Parameter1>LicenseURL</_Parameter1>
	  <_Parameter2>https://www.mozilla.org/en-US/MPL/2.0/</_Parameter2>
	</AssemblyAttribute>
	<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	  <_Parameter1>Repository</_Parameter1>
	  <_Parameter2>https://github.com/MLAstroRPA/MLAstroRPA.NINA.Plugin</_Parameter2>
	</AssemblyAttribute>
	<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	  <_Parameter1>Homepage</_Parameter1>
	  <_Parameter2>https://github.com/MLAstroRPA/MLAstroRPA.NINA.Plugin</_Parameter2>
	</AssemblyAttribute>
	<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	  <_Parameter1>Tags</_Parameter1>
	  <_Parameter2>Polar Alignment,Motor Control,Hardware</_Parameter2>
	</AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="NewFolder\**" />
    <Compile Remove="Tools\**" />
    <EmbeddedResource Remove="NewFolder\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="NewFolder\**" />
    <None Remove="Tools\**" />
    <Page Remove="NewFolder\**" />
    <Page Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="Installer\MSI\MLAstro.RPA.Installer.wixproj" />
  </ItemGroup>
	 
	
  <ItemGroup>
    <Resource Include="Resources\MRPA-on.svg" />
    <Resource Include="Resources\MRPA-off.svg" />
  </ItemGroup>


  <ItemGroup>
    <!-- System.IO.Ports - compile-time only; resolved from NINA app folder at runtime, not copied to output -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" GeneratePathProperty="False" ExcludeAssets="runtime" />
    <!-- System.Management - compile-time only for USB device-change events; resolved from NINA at runtime -->
    <PackageReference Include="System.Management" Version="8.0.0" GeneratePathProperty="False" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Keep the output a single plugin DLL: remove the runtimes folder and any NINA/Nito/CommunityToolkit assemblies
       NuGet may have copied into the output (NINA supplies them from its own app folder at runtime). -->
  <Target Name="ExcludeRuntimesFolder" AfterTargets="Build;Publish;CopyFilesToOutputDirectory" BeforeTargets="PostBuildEvent">
    <RemoveDir Directories="$(OutputPath)runtimes" Condition="Exists('$(OutputPath)runtimes')" />
    <RemoveDir Directories="$(OutDir)runtimes" Condition="Exists('$(OutDir)runtimes')" />
    <RemoveDir Directories="$(TargetDir)runtimes" Condition="Exists('$(TargetDir)runtimes')" />
    <Delete Files="$(TargetDir)NINA*.dll;$(TargetDir)Nito*.dll;$(TargetDir)CommunityToolkit*.dll;$(TargetDir)System.ComponentModel.Composition.dll" />
    <Message Importance="High" Text="[MLAstro] Removed runtimes folder and NINA/dependency assemblies from output" />
  </Target>

  <!-- NINA reference assemblies come from the official NuGet meta-package (same approach as the upstream TPPA plugin).
       We compile against NINA 3.0.0.9001 - the oldest supported NINA 3.x. Because NINA assemblies are non-strong-named
       (PublicKeyToken=null), the runtime binds them by simple name only -> a plugin built against NINA 3.0 loads on
       NINA 3.0 / 3.1 / 3.2 / ... without recompiling. NINA supplies the NINA.* assemblies from its own app folder at
       runtime, so ExcludeAssets="runtime" keeps the output a single plugin DLL (nothing NINA.* is copied to the plugin folder). -->
  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.0.0.9001" ExcludeAssets="runtime" />
    <!-- MEF attributes ([Export] / [ImportingConstructor]) - compile-time only; resolved from the NINA app folder at runtime -->
    <PackageReference Include="System.ComponentModel.Composition" Version="8.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" DependsOnTargets="ExcludeRuntimesFolder">
		<PropertyGroup>
			<PluginTargetDir>$(LOCALAPPDATA)\NINA\Plugins\3.0.0\MLAstro_Robotic_Polar_Alignment</PluginTargetDir>
		</PropertyGroup>
		<!-- Stop NINA if running (2>nul suppresses the benign "process not found" stderr warning) -->
		<Exec Command="taskkill /f /im NINA.exe 2>nul" ContinueOnError="true" IgnoreExitCode="true" />
		<!-- Wait for NINA to fully exit so the plugin DLL handle is released before copying.
		     Without this, the Copy task hits MSB3026 "file is being used by another process"
		     retry warning when NINA was just running. No delay when NINA is already closed. -->
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;for ($i=0; $i -lt 50; $i++) { if (-not (Get-Process -Name NINA -ErrorAction SilentlyContinue)) { break }; Start-Sleep -Milliseconds 200 }&quot;" ContinueOnError="true" IgnoreExitCode="true" />
		<!-- Create target directory if not exists -->
		<MakeDir Directories="$(PluginTargetDir)" Condition="!Exists('$(PluginTargetDir)')" />
		<!-- Copy files -->
		<ItemGroup>
			<PluginFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)runtimes\**\*.*;$(TargetDir)*.runtimeconfig.json;$(TargetDir)*.deps.json" />
		</ItemGroup>
		<Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginTargetDir)\%(RecursiveDir)" />
		<!-- Remove runtimes folder from target if it exists -->
		<RemoveDir Directories="$(PluginTargetDir)\runtimes" Condition="Exists('$(PluginTargetDir)\runtimes')" />
		<Message Importance="High" Text="[MLAstro] Plugin copied to NINA folder: $(PluginTargetDir)" />
	</Target>

	<!-- Keep the MSI/GitHub-release staging copy of the plugin DLL fresh on every Release build -->
	<Target Name="RefreshInstallerPluginDll" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<StagedPluginDir>$(ProjectDir)Installer\MSI\Plugin\MLAstro_Robotic_Polar_Alignment</StagedPluginDir>
		</PropertyGroup>
		<MakeDir Directories="$(StagedPluginDir)" Condition="!Exists('$(StagedPluginDir)')" />
		<Copy SourceFiles="$(TargetDir)MLAstro_Robotic_Polar_Alignment.dll" DestinationFolder="$(StagedPluginDir)" />
		<Message Importance="High" Text="[MLAstro] Plugin DLL copied to MSI staging: $(StagedPluginDir)" />
	</Target>

</Project>
